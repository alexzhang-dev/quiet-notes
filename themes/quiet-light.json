{
  "name": "quiet-light",
  "type": "light",
  "colors": {
    "editor.background": "#eef0f2",
    "editor.foreground": "#141414",
    "editorLineNumber.foreground": "#a0a0a0",
    "editorCursor.foreground": "#d4146a",
    "editor.selectionBackground": "#14141414",
    "editor.lineHighlightBackground": "#14141408",
    "editorWhitespace.foreground": "#1414141a",
    "editorIndentGuide.background": "#14141414",
    "editorIndentGuide.activeBackground": "#14141433",
    "editorWidget.background": "#e8eaec",
    "editorWidget.border": "#14141414",
    "sideBar.background": "#eef0f2",
    "activityBar.background": "#e8eaec",
    "statusBar.background": "#e8eaec",
    "statusBar.foreground": "#5c5c5c",
    "titleBar.activeBackground": "#eef0f2",
    "titleBar.activeForeground": "#141414",
    "terminal.background": "#eef0f2",
    "terminal.foreground": "#141414"
  },
  "tokenColors": [
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "foreground": "#8a8a8a",
        "fontStyle": "italic"
      }
    },
    {
      "name": "String",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#5c5c5c"
      }
    },
    {
      "name": "Keyword",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.other",
        "storage.type",
        "storage.modifier",
        "storage.type.function",
        "storage.type.class"
      ],
      "settings": {
        "foreground": "#d4146a"
      }
    },
    {
      "name": "Storage / declaration leftovers",
      "scope": [
        "storage"
      ],
      "settings": {
        "foreground": "#d4146a"
      }
    },
    {
      "name": "Function",
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "support.function",
        "meta.function entity.name.function"
      ],
      "settings": {
        "foreground": "#2a2a2a"
      }
    },
    {
      "name": "Type / class",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.other.inherited-class",
        "support.type",
        "support.class",
        "entity.name.namespace",
        "entity.name.module"
      ],
      "settings": {
        "foreground": "#636363"
      }
    },
    {
      "name": "Number / constant",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character",
        "constant.other",
        "support.constant"
      ],
      "settings": {
        "foreground": "#4a4a4a"
      }
    },
    {
      "name": "Variable",
      "scope": [
        "variable",
        "variable.other",
        "variable.parameter",
        "meta.definition.variable",
        "support.variable"
      ],
      "settings": {
        "foreground": "#141414"
      }
    },
    {
      "name": "Operator",
      "scope": [
        "keyword.operator",
        "keyword.operator.assignment",
        "keyword.operator.arithmetic",
        "keyword.operator.comparison",
        "keyword.operator.logical"
      ],
      "settings": {
        "foreground": "#6e6e6e"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "meta.brace",
        "punctuation.definition.parameters",
        "punctuation.definition.block",
        "punctuation.separator",
        "punctuation.terminator",
        "meta.delimiter"
      ],
      "settings": {
        "foreground": "#7a7a7a"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#b00040"
      }
    },
    {
      "name": "Markdown headings",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown"
      ],
      "settings": {
        "foreground": "#2a2a2a",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown bold / italic",
      "scope": [
        "markup.bold",
        "markup.italic"
      ],
      "settings": {
        "foreground": "#141414"
      }
    },
    {
      "name": "Markdown link / code",
      "scope": [
        "markup.underline.link",
        "markup.inline.raw",
        "markup.fenced_code",
        "markup.raw"
      ],
      "settings": {
        "foreground": "#5c5c5c"
      }
    },
    {
      "name": "Property / attribute",
      "scope": [
        "support.type.property-name",
        "entity.name.tag",
        "entity.other.attribute-name",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#3a3a3a"
      }
    }
  ]
}
